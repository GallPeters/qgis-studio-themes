/* =========================================================================
 * QGIS Studio Themes — shared stylesheet
 * -------------------------------------------------------------------------
 * One stylesheet for every Studio theme; colours come from base.qss and the
 * theme's variables.qss, resolved by the plugin at load time.
 *
 * Performance notes
 *  - Base colours (window, text, base, highlight, disabled text) come from
 *    the Qt palette the plugin installs, not from blanket `*` / `QWidget`
 *    rules, so plain widgets are not forced to paint a styled background.
 *  - Selectors stay shallow (type or type#name, rarely one ancestor) and
 *    shared states use common base classes (QAbstractItemView,
 *    QAbstractSpinBox) instead of long per-class lists. Descendant
 *    selectors on common widgets (QLabel, QLineEdit) and attribute
 *    selectors on QFrame (every QLabel is one) are avoided: Qt evaluates
 *    them for every such widget; separators use the palette instead.
 *  - Popups (menus, combo lists, tooltips) keep square frames: rounded
 *    top-level frames need translucent windows, which cost a compositing
 *    pass and break on X11 without a compositor. Rows inside are rounded.
 * =========================================================================
 */

/* =========================================================================
 * 1. WINDOWS & DOCKS
 * ========================================================================= */

QMainWindow::separator {
    background-color: @bg_window;
    width: 5px;
    height: 5px;
}
QMainWindow::separator:hover {
    background-color: @accent;
}

QDockWidget {
    color: @text_dim;
    titlebar-close-icon: url(@theme_path/icons/studio/close.svg);
    titlebar-normal-icon: url(@theme_path/icons/studio/float.svg);
}
QDockWidget > QWidget {
    background-color: @bg_dock;
    border-top: 1px solid @divider;
}
QDockWidget::title {
    background-color: @bg_window;
    padding: 7px 10px 6px 10px;
    text-align: left;
}
QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    border-radius: @radius_sm;
    padding: 2px;
    icon-size: 14px;
}
QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: @tool_hover;
}
QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background-color: @tool_pressed;
}

QStatusBar {
    background-color: @bg_window;
    color: @text_dim;
    border-top: 1px solid @divider;
    min-height: 30px;
    padding: 2px 6px;
}
QStatusBar::item {
    border: none;
}
QSizeGrip {
    width: 12px;
    height: 12px;
}

/* =========================================================================
 * 2. MENU BAR, MENUS, TOOLBARS
 * ========================================================================= */

QMenuBar {
    background-color: @bg_window;
    border-bottom: 1px solid @divider;
    padding: 3px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: @radius_sm;
}
QMenuBar::item:selected {
    background-color: @tool_hover;
    color: @text_bright;
}
QMenuBar::item:pressed {
    background-color: @tool_checked;
    color: @text_bright;
}

QMenu {
    background-color: @bg_menu;
    border: 1px solid @menu_border;
    padding: 5px;
}
QMenu::item {
    background: transparent;
    padding: 6px 28px 6px 10px;
    border-radius: @radius_sm;
}
QMenu::item:selected {
    background-color: @menu_hover;
    color: @text_bright;
}
QMenu::item:disabled {
    color: @text_disabled;
    background: transparent;
}
QMenu::icon {
    padding-left: 8px;
}
QMenu::separator {
    height: 1px;
    background-color: @menu_border;
    margin: 5px 6px;
}
QMenu::section {
    color: @text_dim;
    padding: 6px 10px 4px 10px;
    font-weight: 600;
}
QMenu::right-arrow {
    image: url(@theme_path/icons/studio/chevron-right.svg);
    width: 12px;
    height: 12px;
    margin-right: 6px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 8px;
    border-radius: @radius_sm;
}
QMenu::indicator:non-exclusive:checked {
    background-color: @accent;
    image: url(@theme_path/icons/studio/checkbox-check.svg);
}
QMenu::indicator:exclusive:checked {
    background-color: @accent;
    border-radius: 7px;
    image: url(@theme_path/icons/studio/radio-dot.svg);
}

QToolBar {
    background-color: @bg_window;
    border: none;
    padding: 3px 4px;
    spacing: 2px;
}
QToolBar::handle {
    background: transparent;
    width: 6px;
    height: 6px;
}
/* Room for the toolbar name label the plugin paints over the handle. */
QToolBar[studioLabel="true"]::handle {
    width: 11px;
    height: 13px;
}
QToolBar::separator {
    background-color: @divider_strong;
    width: 1px;
    height: 1px;
    margin: 6px 5px;
}
QToolBar::extension-button,
QToolButton#qt_toolbar_ext_button {
    qproperty-icon: url();
    image: url(@theme_path/icons/studio/chevron-down.svg);
    background: transparent;
    border: none;
    border-radius: @radius_sm;
    padding: 2px;
}
QToolBar::extension-button:hover,
QToolButton#qt_toolbar_ext_button:hover {
    background-color: @tool_hover;
}

/* =========================================================================
 * 3. BUTTONS
 * ========================================================================= */

QToolButton {
    background: transparent;
    border: none;
    border-radius: @radius;
    padding: 3px;
}
QToolButton:hover {
    background-color: @tool_hover;
}
QToolButton:pressed {
    background-color: @tool_pressed;
}
QToolButton:checked {
    background-color: @tool_checked;
    color: @text_bright;
}
QToolButton:checked:hover {
    background-color: @tool_checked_hover;
}
QToolButton:disabled {
    color: @text_disabled;
}
QToolButton[popupMode="1"] {
    padding-right: 16px;
}
QToolButton[popupMode="2"] {
    padding-right: 12px;
}
QToolButton::menu-button {
    border: none;
    border-top-right-radius: @radius;
    border-bottom-right-radius: @radius;
    width: 14px;
}
QToolButton::menu-button:hover {
    background-color: @tool_hover;
}
QToolButton::menu-indicator,
QToolButton::menu-arrow {
    image: url(@theme_path/icons/studio/chevron-down.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
}
QToolButton::menu-indicator:disabled,
QToolButton::menu-arrow:disabled {
    image: url(@theme_path/icons/studio/arrow-down-disabled.svg);
}

QPushButton {
    background-color: @control_bg;
    border: 1px solid @divider_strong;
    border-radius: @radius;
    padding: 4px 14px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: @control_hover;
    border-color: @field_border_hover;
}
QPushButton:pressed {
    background-color: @control_pressed;
}
QPushButton:checked {
    background-color: @tool_checked;
    border-color: @accent;
    color: @text_bright;
}
QPushButton:focus {
    border-color: @accent;
}
QPushButton:default {
    background-color: @accent;
    border-color: @accent;
    color: @on_accent;
    font-weight: 600;
}
QPushButton:default:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}
QPushButton:default:pressed {
    background-color: @accent_pressed;
}
QPushButton:disabled {
    background-color: @control_pressed;
    border-color: @divider;
    color: @text_disabled;
}
QPushButton::menu-indicator {
    image: url(@theme_path/icons/studio/chevron-down.svg);
    width: 10px;
    height: 10px;
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: -8px;
}
QgsExpressionBuilderWidget QPushButton {
    min-width: 20px;
    padding: 4px 6px;
}

/* =========================================================================
 * 4. TEXT, NUMBER & CHOICE INPUTS
 * ========================================================================= */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QAbstractSpinBox,
QComboBox {
    background-color: @bg_base;
    border: 1px solid @field_border;
    border-radius: @radius;
    selection-background-color: @accent;
    selection-color: @on_accent;
}
QLineEdit,
QAbstractSpinBox {
    padding: 3px 8px;
    min-height: 18px;
}
QTextEdit,
QPlainTextEdit {
    padding: 2px;
}
QLineEdit:hover,
QAbstractSpinBox:hover,
QComboBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: @field_border_hover;
}
QLineEdit:focus,
QAbstractSpinBox:focus,
QComboBox:focus,
QComboBox:on,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: @accent;
}
QLineEdit:disabled,
QAbstractSpinBox:disabled,
QComboBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: @bg_window;
    border-color: @divider;
    color: @text_disabled;
}
QLineEdit:read-only {
    background-color: @bg_window;
}

QAbstractSpinBox {
    padding-right: 20px;
}
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
    subcontrol-origin: border;
}
QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    margin: 2px 2px 0 0;
    border-top-right-radius: @radius_sm;
}
QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    margin: 0 2px 2px 0;
    border-bottom-right-radius: @radius_sm;
}
QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: @tool_hover;
}
QAbstractSpinBox::up-button:pressed,
QAbstractSpinBox::down-button:pressed {
    background-color: @tool_checked;
}
QAbstractSpinBox::up-arrow {
    image: url(@theme_path/icons/studio/arrow-up.svg);
    width: 8px;
    height: 8px;
}
QAbstractSpinBox::down-arrow {
    image: url(@theme_path/icons/studio/arrow-down.svg);
    width: 8px;
    height: 8px;
}
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
    image: url(@theme_path/icons/studio/arrow-up-disabled.svg);
}
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
    image: url(@theme_path/icons/studio/arrow-down-disabled.svg);
}

QComboBox {
    padding: 3px 8px;
    min-height: 18px;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}
QComboBox::down-arrow {
    image: url(@theme_path/icons/studio/chevron-down.svg);
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:disabled {
    image: url(@theme_path/icons/studio/arrow-down-disabled.svg);
}
QComboBox QAbstractItemView {
    background-color: @bg_menu;
    color: @text;
    border: 1px solid @menu_border;
    border-radius: 0;
    padding: 4px;
    outline: none;
    selection-background-color: @menu_hover;
    selection-color: @text_bright;
}
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    min-height: 20px;
    border-radius: @radius_sm;
}
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: @menu_hover;
    color: @text_bright;
}

/* =========================================================================
 * 5. ITEM VIEWS (lists, trees, tables) & HEADERS
 * ========================================================================= */

QAbstractItemView {
    border: 1px solid @divider;
    border-radius: @radius;
    outline: none;
}
QTableView {
    gridline-color: @grid;
}
QTableView QTableCornerButton::section {
    background-color: @header_bg;
    border: none;
    border-right: 1px solid @divider;
    border-bottom: 1px solid @divider;
}

QHeaderView {
    background-color: @header_bg;
    border: none;
}
QHeaderView::section {
    background-color: @header_bg;
    color: @text_dim;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid @divider;
    border-bottom: 1px solid @divider;
    font-weight: 600;
}
QHeaderView::section:hover {
    background-color: @row_hover;
    color: @text;
}
QHeaderView::section:checked {
    color: @text_bright;
}
QHeaderView::up-arrow {
    image: url(@theme_path/icons/studio/arrow-up.svg);
    width: 8px;
    height: 8px;
}
QHeaderView::down-arrow {
    image: url(@theme_path/icons/studio/arrow-down.svg);
    width: 8px;
    height: 8px;
}

/* =========================================================================
 * 6. TABS
 * ========================================================================= */

QTabWidget::pane {
    background-color: @bg_window;
    border: 1px solid @divider;
    border-radius: @radius;
    top: -1px;
}
QTabWidget::tab-bar {
    left: 6px;
}
QTabBar {
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background: transparent;
    color: @text_dim;
    border: none;
    padding: 6px 12px;
    margin: 0 2px;
}
QTabBar::tab:top {
    border-bottom: 2px solid transparent;
}
QTabBar::tab:bottom {
    border-top: 2px solid transparent;
}
QTabBar::tab:left {
    border-right: 2px solid transparent;
    padding: 8px 8px;
}
QTabBar::tab:right {
    border-left: 2px solid transparent;
    padding: 8px 8px;
}
QTabBar::tab:hover {
    color: @text;
}
QTabBar::tab:selected {
    color: @text_bright;
}
QTabBar::tab:top:selected {
    border-bottom-color: @accent;
}
QTabBar::tab:bottom:selected {
    border-top-color: @accent;
}
QTabBar::tab:left:selected {
    border-right-color: @accent;
}
QTabBar::tab:right:selected {
    border-left-color: @accent;
}
QTabBar::close-button {
    image: url(@theme_path/icons/studio/close.svg);
    subcontrol-position: right;
    border-radius: @radius_sm;
}
QTabBar::close-button:hover {
    background-color: @tool_hover;
}

/* =========================================================================
 * 7. SCROLLBARS
 * ========================================================================= */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle {
    background-color: @scroll_handle;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    min-height: 32px;
    margin: 2px 2px 2px 2px;
}
QScrollBar::handle:horizontal {
    min-width: 32px;
    margin: 2px 2px 2px 2px;
}
QScrollBar::handle:hover,
QScrollBar::handle:pressed {
    background-color: @scroll_handle_hover;
}
QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}
QAbstractScrollArea::corner {
    background: transparent;
}

/* =========================================================================
 * 8. CHECKBOXES, RADIO BUTTONS & ITEM INDICATORS
 * ========================================================================= */

QCheckBox,
QRadioButton {
    background: transparent;
    spacing: 8px;
}
QCheckBox::indicator,
QGroupBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @field_border_hover;
    background-color: @bg_base;
    border-radius: @radius_sm;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @field_border_hover;
    background-color: @bg_base;
    border-radius: 8px;
}
QCheckBox::indicator:hover,
QRadioButton::indicator:hover,
QGroupBox::indicator:hover {
    border-color: @accent;
}
QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
    image: url(@theme_path/icons/studio/checkbox-check.svg);
}
QRadioButton::indicator:checked {
    background-color: @accent;
    border-color: @accent;
    image: url(@theme_path/icons/studio/radio-dot.svg);
}
QCheckBox::indicator:checked:hover,
QRadioButton::indicator:checked:hover,
QGroupBox::indicator:checked:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}
QCheckBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate {
    background-color: @accent_indeterminate;
    border-color: @accent_indeterminate;
    image: url(@theme_path/icons/studio/checkbox-indeterminate.svg);
}
QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled,
QGroupBox::indicator:disabled {
    background-color: @bg_window;
    border-color: @divider_strong;
}
QCheckBox::indicator:checked:disabled,
QRadioButton::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled {
    background-color: @accent_disabled;
    border-color: @accent_disabled;
}

/* =========================================================================
 * 9. GROUPS, SPLITTERS & FRAMES
 * ========================================================================= */

QGroupBox,
QgsCollapsibleGroupBox,
QgsCollapsibleGroupBoxBasic {
    background-color: transparent;
    border: 1px solid @divider;
    border-radius: @radius_lg;
    margin-top: 14px;
    padding: 10px 8px 6px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: @text_dim;
    font-weight: 600;
}
QSplitter::handle {
    background-color: transparent;
}
QSplitter::handle:horizontal {
    width: 5px;
}
QSplitter::handle:vertical {
    height: 5px;
}
QSplitter::handle:hover {
    background-color: @accent;
}

/* =========================================================================
 * 10. FEEDBACK (progress, sliders, tooltips, rubber band)
 * ========================================================================= */

QProgressBar {
    background-color: @control_bg;
    color: @text;
    border: none;
    border-radius: @radius_sm;
    text-align: center;
    min-height: 14px;
}
QProgressBar::chunk {
    background-color: @accent;
    border-radius: @radius_sm;
}

QSlider::groove:horizontal {
    background-color: @control_hover;
    height: 4px;
    border-radius: 2px;
}
QSlider::groove:vertical {
    background-color: @control_hover;
    width: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal,
QSlider::add-page:vertical {
    background-color: @accent;
    border-radius: 2px;
}
QSlider::handle:horizontal,
QSlider::handle:vertical {
    background-color: @bg_base;
    border: 3px solid @accent;
    width: 10px;
    height: 10px;
    border-radius: 8px;
}
QSlider::handle:horizontal {
    margin: -6px 0;
}
QSlider::handle:vertical {
    margin: 0 -6px;
}
QSlider::handle:hover {
    border-color: @accent_hover;
}

QToolTip {
    background-color: @bg_menu;
    color: @text;
    border: 1px solid @menu_border;
    padding: 5px 8px;
}
QRubberBand {
    background-color: @accent_translucent;
    border: 1px solid @accent;
}

/* =========================================================================
 * 11. QGIS WIDGETS
 * ========================================================================= */

/* Panels inside docks read as one surface: no inner frames. */
QgsLayerTreeView,
QgsBrowserTreeView,
QgsProcessingToolboxTreeView,
QgsDockWidget QTreeView,
QgsDockWidget QListView {
    background-color: @bg_dock;
    border: none;
    border-radius: 0;
}

QgsColorButton,
QgsColorRampButton {
    background-color: @bg_base;
    border: 1px solid @field_border;
    border-radius: @radius;
    padding: 2px;
    min-height: 18px;
}
QgsColorButton:hover,
QgsColorRampButton:hover {
    border-color: @accent;
}
QgsPropertyOverrideButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @radius_sm;
    padding: 2px;
}
QgsPropertyOverrideButton:hover {
    background-color: @tool_hover;
}
QgsCodeEditor {
    border: 1px solid @divider;
    border-radius: @radius;
}

/* ---- Options / properties navigation lists ------------------------------ */
QListWidget#mOptionsListWidget,
QListWidget#mOptListWidget,
QListView#mOptionsListWidget,
QTreeView#mOptionsTreeView,
QgsOptionsTreeView {
    background-color: @bg_window;
    border: none;
    border-radius: 0;
    padding: 4px;
}
QListWidget#mOptionsListWidget::item,
QListWidget#mOptListWidget::item,
QListView#mOptionsListWidget::item,
QTreeView#mOptionsTreeView::item,
QgsOptionsTreeView::item {
    padding: 6px 8px;
    margin: 1px 0;
    border-radius: @radius;
    border-left: 3px solid transparent;
}
QListWidget#mOptionsListWidget::item:selected,
QListWidget#mOptListWidget::item:selected,
QListView#mOptionsListWidget::item:selected,
QTreeView#mOptionsTreeView::item:selected,
QgsOptionsTreeView::item:selected {
    background-color: @row_selected;
    border-left-color: @accent;
    color: @text_bright;
}

/* ---- Layer Styling / Dev Tools: vertical icon rail ---------------------- */
QgsLayerStylingWidget QListWidget#mOptionsListWidget,
QgsDevToolsPanelWidget QListWidget#mOptionsListWidget {
    background-color: @bg_window;
    border: none;
    border-right: 1px solid @divider;
    padding: 4px;
    min-width: 48px;
    max-width: 48px;
}
QgsLayerStylingWidget QListWidget#mOptionsListWidget::item,
QgsDevToolsPanelWidget QListWidget#mOptionsListWidget::item {
    padding: 6px 0 6px 6px;
    margin: 1px 0;
    min-height: 28px;
    border-left: none;
    border-radius: @radius;
}

/* ---- Plugin manager list ------------------------------------------------ */
QListView#vwPlugins::item {
    padding: 6px 8px;
    border-bottom: 1px solid @divider;
    border-radius: 0;
    min-height: 28px;
}
