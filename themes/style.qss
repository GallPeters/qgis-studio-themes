/* =========================================================================
 * QGIS Studio Themes — shared stylesheet
 * -------------------------------------------------------------------------
 * One stylesheet for every Studio theme; colours come from base.qss and the
 * theme's variables.qss, resolved by the plugin at load time.
 *
 * Performance notes
 *  - Base colours (window, text, base, highlight, disabled text) come from
 *    the Qt palette the plugin installs, not from blanket `*` / `QWidget`
 *    rules, so plain widgets are not forced to paint a styled background.
 *  - Selectors stay shallow (type or type#name, rarely one ancestor) and
 *    shared states use common base classes (QAbstractItemView,
 *    QAbstractSpinBox) instead of long per-class lists. Descendant
 *    selectors on common widgets (QLabel, QLineEdit) and attribute
 *    selectors on QFrame (every QLabel is one) are avoided: Qt evaluates
 *    them for every such widget; separators use the palette instead.
 *  - Popups (menus, combo lists, tooltips) keep square frames: rounded
 *    top-level frames need translucent windows, which cost a compositing
 *    pass and break on X11 without a compositor. Rows inside are rounded.
 * =========================================================================
 */

/* =========================================================================
 * 1. WINDOWS & DOCKS
 * ========================================================================= */

/* Splitters between panels and the map: a 1 px line centred in the 5 px
 * grip (a 2 px border in the window colour around the line colour, so it
 * works across and along), so panels, canvas and toolbars read as separate
 * regions; 3 px of accent while dragged or hovered. */
QMainWindow::separator {
    background-color: @line;
    border: 2px solid @bg_window;
    width: 1px;
    height: 1px;
}
QMainWindow::separator:hover {
    background-color: @accent;
    border-width: 1px;
}

/* The map has no frame of its own: the splitter lines beside it, the line
 * under the toolbar rows and the status bar's top edge already outline it,
 * and its frame drew a second line next to each of them. */
QgsMapCanvas {
    border: none;
}

QDockWidget {
    color: @text;
    /* Qt draws the title buttons' icons at 10 px whatever the stylesheet
     * says; these glyphs are drawn for that size and fill it (the 16 px
     * tab close glyph shrank to two faint dots). */
    titlebar-close-icon: url(@theme_path/icons/studio/dock-close.svg);
    titlebar-normal-icon: url(@theme_path/icons/studio/dock-float.svg);
}
/* Panel titles: one point larger (compact sizes: same size) and semibold,
 * so panels are easy to find and tell apart. The (title-less) font goes on the dock, the contents get
 * the normal UI font back (sizes filled in by the plugin). */
QMainWindow > QDockWidget {
    font-size: @panel_title_font_size;
    font-weight: 600;
}
QMainWindow > QDockWidget > QWidget {
    font-size: @ui_font_size;
    font-weight: normal;
}
QDockWidget > QWidget {
    background-color: @bg_dock;
    border-top: 1px solid @dock_seam;
}
QDockWidget::title {
    background-color: @bg_window;
    padding: 8px 10px 7px 10px;
    text-align: left;
}
QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    border-radius: @radius_sm;
    padding: 0;
}
QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: @tool_hover;
}
QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background-color: @tool_pressed;
}

QStatusBar {
    background-color: @bg_window;
    color: @text_dim;
    border-top: 1px solid @divider;
    min-height: 30px;
    padding: 2px 6px;
}
/* Labels are dimmed and values sit in borderless chips of one height, their
 * border shown on hover (they stay recognisably editable) and focus. */
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: @text_dim;
}
QStatusBar QLineEdit,
QStatusBar QComboBox,
QStatusBar QAbstractSpinBox {
    background-color: @control_bg;
    border-color: transparent;
    border-radius: 5px;
    min-height: 0;
    padding: 1px 6px;
}
QStatusBar QAbstractSpinBox {
    padding-right: 20px;
}
QStatusBar QLineEdit:hover,
QStatusBar QComboBox:hover,
QStatusBar QAbstractSpinBox:hover {
    border-color: @field_border_hover;
}
QStatusBar QLineEdit:focus,
QStatusBar QComboBox:focus,
QStatusBar QComboBox:on,
QStatusBar QAbstractSpinBox:focus {
    background-color: @bg_base;
    border-width: 1px;
    border-color: @accent;
    padding: 1px 6px;
}
QStatusBar QAbstractSpinBox:focus {
    padding-right: 20px;
}
QSizeGrip {
    width: 12px;
    height: 12px;
}

/* =========================================================================
 * 2. MENU BAR, MENUS, TOOLBARS
 * ========================================================================= */

QMenuBar {
    background-color: @bg_window;
    border-bottom: 1px solid @line;
    padding: 3px 6px;
}
/* Main menu above the UI font (size filled in by the plugin);
 * the child selector outranks QGIS's own application-wide font rule. */
QMainWindow > QMenuBar {
    font-size: @menu_font_size;
}
QMenuBar::item {
    background: transparent;
    padding: 5px @menu_item_padding_x;
    border-radius: @radius_sm;
}
QMenuBar::item:selected {
    background-color: @tool_hover;
    color: @text_bright;
}
QMenuBar::item:pressed {
    background-color: @tool_checked;
    color: @text_bright;
}

/* Popups stay square (see the performance notes) and are lifted off the
 * window by their surface: a step lighter than the window (dark themes)
 * with one even edge, no drop shadow (see set_popup_shadows). */
QMenu {
    background-color: @bg_menu;
    border: 1px solid @menu_edge;
    padding: 5px;
}
QMenu::item {
    background: transparent;
    padding: 6px 28px 6px 10px;
    border-radius: @radius_sm;
}
QMenu::item:selected {
    background-color: @menu_hover;
    color: @text_bright;
}
QMenu::item:disabled {
    color: @text_disabled;
    background: transparent;
}
QMenu::icon {
    padding-left: 8px;
}
QMenu::separator {
    height: 1px;
    background-color: @menu_border;
    margin: 5px 6px;
}
QMenu::section {
    color: @text_dim;
    padding: 6px 10px 4px 10px;
    font-weight: 600;
}
/* Widget glyphs (themes/icons) are drawn on a grid of the exact size they
 * are shown at here, with straight edges on whole pixels: keep a glyph's
 * width/height in sync with its file when changing either. */
QMenu::right-arrow {
    image: url(@theme_path/icons/studio/chevron-right.svg);
    width: 12px;
    height: 12px;
    margin-right: 6px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 8px;
    border-radius: @radius_sm;
}
/* Checked menu items: the mark alone, in the accent colour, not a filled
 * box: a column of filled boxes (View > Panels) read as heavy. */
QMenu::indicator:non-exclusive:checked {
    image: url(@theme_path/icons/studio/menu-check.svg);
}
QMenu::indicator:exclusive:checked {
    image: url(@theme_path/icons/studio/menu-dot.svg);
}

QToolBar {
    background-color: @bg_window;
    border: none;
    padding: 3px 4px;
    spacing: 2px;
}
QToolBar::handle {
    background: transparent;
    width: 6px;
    height: 6px;
}
/* Toolbars inside panels (Browser, Layers, Processing Toolbox...) and the
 * main panel trees get 20 px icons instead of QGIS's small dock default;
 * filled in by the plugin, empty with compact sizes (low-density screens),
 * where they keep QGIS's own size. */
@panel_icon_rules
/* The main panels share one rhythm: roomy rows (padding, not a fixed
 * height, keeps taller legend entries in the Layers panel intact), drawn
 * as soft pills that end short of the panel's right edge. Hover and
 * selection run the full row: the branch column (expand arrows and
 * indentation) on the left takes the same colour, so the highlight has no
 * gap, and the row's left corners stay square where they meet it. */
QgsBrowserTreeView,
QgsLayerTreeView,
QgsProcessingToolboxTreeView {
    show-decoration-selected: 1;
}
QgsBrowserTreeView::item,
QgsLayerTreeView::item,
QgsProcessingToolboxTreeView::item {
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 6px;
    border-radius: @radius;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}
QgsBrowserTreeView::item:hover,
QgsLayerTreeView::item:hover,
QgsProcessingToolboxTreeView::item:hover,
QgsBrowserTreeView::branch:hover,
QgsLayerTreeView::branch:hover,
QgsProcessingToolboxTreeView::branch:hover {
    background-color: @panel_row_hover;
}
QgsBrowserTreeView::item:selected,
QgsLayerTreeView::item:selected,
QgsProcessingToolboxTreeView::item:selected,
QgsBrowserTreeView::branch:selected,
QgsLayerTreeView::branch:selected,
QgsProcessingToolboxTreeView::branch:selected {
    background-color: @panel_row_selected;
    color: @text_bright;
}
QgsBrowserTreeView::item:selected:!active,
QgsLayerTreeView::item:selected:!active,
QgsProcessingToolboxTreeView::item:selected:!active,
QgsBrowserTreeView::branch:selected:!active,
QgsLayerTreeView::branch:selected:!active,
QgsProcessingToolboxTreeView::branch:selected:!active {
    background-color: @panel_row_selected_inactive;
    color: @text;
}
/* Expand arrows of the main panels, the symbol layer tree, the expression
 * builder's function tree and the Options page tree as outline chevrons,
 * like every other arrow. Only these trees: their rows already go through the stylesheet (the rules
 * above and below; the other two trees are small), while
 * a ::branch rule on every tree would send all of QGIS's lists through Qt's
 * slower stylesheet drawing. */
QgsBrowserTreeView::branch:has-children:!has-siblings:closed,
QgsBrowserTreeView::branch:closed:has-children:has-siblings,
QgsLayerTreeView::branch:has-children:!has-siblings:closed,
QgsLayerTreeView::branch:closed:has-children:has-siblings,
QgsProcessingToolboxTreeView::branch:has-children:!has-siblings:closed,
QgsProcessingToolboxTreeView::branch:closed:has-children:has-siblings,
QTreeView#layersTree::branch:has-children:!has-siblings:closed,
QTreeView#layersTree::branch:closed:has-children:has-siblings,
QgsExpressionTreeView::branch:has-children:!has-siblings:closed,
QgsExpressionTreeView::branch:closed:has-children:has-siblings,
QTreeView#mOptionsTreeView::branch:has-children:!has-siblings:closed,
QTreeView#mOptionsTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(@theme_path/icons/studio/branch-closed.svg);
}
QgsBrowserTreeView::branch:open:has-children:!has-siblings,
QgsBrowserTreeView::branch:open:has-children:has-siblings,
QgsLayerTreeView::branch:open:has-children:!has-siblings,
QgsLayerTreeView::branch:open:has-children:has-siblings,
QgsProcessingToolboxTreeView::branch:open:has-children:!has-siblings,
QgsProcessingToolboxTreeView::branch:open:has-children:has-siblings,
QTreeView#layersTree::branch:open:has-children:!has-siblings,
QTreeView#layersTree::branch:open:has-children:has-siblings,
QgsExpressionTreeView::branch:open:has-children:!has-siblings,
QgsExpressionTreeView::branch:open:has-children:has-siblings,
QTreeView#mOptionsTreeView::branch:open:has-children:!has-siblings,
QTreeView#mOptionsTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(@theme_path/icons/studio/branch-open.svg);
}
/* Expression builder: QGIS paints its group rows (Aggregates, Arrays...)
 * with a fixed grey block; the rows read as headers by their arrows. */
QgsExpressionTreeView::item {
    background: transparent;
}
/* Checkboxes in lists, trees and tables (layer visibility, symbol layers,
 * renderer categories...) match the dialog checkboxes instead of the
 * native tick, which stays black on dark themes and turns blue when its
 * row is selected. */
QAbstractItemView::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @field_border_hover;
    background-color: @bg_base;
    border-radius: @radius_sm;
}
QAbstractItemView::indicator:hover {
    border-color: @accent;
}
QAbstractItemView::indicator:checked {
    background-color: @accent;
    border-color: @accent;
    image: url(@theme_path/icons/studio/checkbox-check.svg);
}
QAbstractItemView::indicator:indeterminate {
    background-color: @accent_indeterminate;
    border-color: @accent_indeterminate;
    image: url(@theme_path/icons/studio/checkbox-indeterminate.svg);
}
QAbstractItemView::indicator:disabled {
    background-color: @bg_window;
    border-color: @divider_strong;
}
QAbstractItemView::indicator:checked:disabled {
    background-color: @accent_disabled;
    border-color: @accent_disabled;
}
/* Separators inside a toolbar are lighter than the dividers between
 * toolbars (@line), so a group inside a toolbar never reads as its edge. */
QToolBar::separator {
    background-color: @divider;
    width: 1px;
    height: 1px;
    margin: 6px 5px;
}
/* Spin boxes and combo boxes in toolbars (snapping tolerance and units,
 * scale) share one height, so their edges line up. */
QToolBar QComboBox,
QToolBar QAbstractSpinBox {
    min-height: 20px;
    max-height: 20px;
}
/* No 2 px focus ring here: it would make the toolbar change height. */
QToolBar QComboBox:focus,
QToolBar QAbstractSpinBox:focus {
    border-width: 1px;
    padding: @control_padding_y 8px;
}
QToolBar QAbstractSpinBox:focus {
    padding-right: 20px;
}
/* Toolbar names (studio_toolbars.py). A docked horizontal toolbar gets a
 * title strip above its buttons ("top") or a thinner one below them, where
 * the name sits in the row's line ("bottom"): every item gets a margin of
 * the strip's height, so the toolbar grows by the strip and its items keep
 * their own layout. A vertical toolbar gets its short name across the top
 * of a taller handle, and a name left of the buttons widens the handle.
 * The strips follow the names' size (a setting): the plugin fills in a
 * rule per size. */
@toolbar_name_rules
/* The toolbar names and lines (pictures drawn by the plugin, see
 * studio_toolbars): placed by hand, never pushed down like the items. */
QLabel#studioToolbarLabel,
QLabel#studioToolbarDivider,
QLabel#studioToolbarRowLine {
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
}
/* The overflow button (buttons that do not fit) shows a double chevron
 * pointing along the toolbar, so it never reads as the small drop-down
 * chevron of a button with more options beside it. */
QToolBar::extension-button,
QToolButton#qt_toolbar_ext_button {
    qproperty-icon: url();
    image: url(@theme_path/icons/studio/toolbar-more.svg);
    background: transparent;
    border: none;
    border-radius: @radius_sm;
    padding: 2px;
}
QToolBar::extension-button:hover,
QToolButton#qt_toolbar_ext_button:hover {
    background-color: @tool_hover;
}
/* The ribbon (studio_ribbon.py): tabs over a page of groups, each named
 * in small capitals beneath and set apart by a soft line; large buttons
 * (icon over label), small ones (icon beside label, or icon only). The
 * page is a soft surface of its own, the current tab opening into it;
 * the ribbon closes off the window's top with the line under the menu
 * bar's colour. */
QToolBar#studioRibbonHost {
    padding: 0px;
    spacing: 0px;
    border: none;
}
QWidget#studioRibbon {
    background-color: @bg_window;
    border-bottom: 1px solid @line;
}
/* While the ribbon shows, the menu bar is folded away: its commands are on
 * the ribbon's tabs (studio_ribbon.set_menu_bar_folded). */
QMenuBar[studioRibbon="true"] {
    border: none;
    padding: 0px;
}
QWidget#studioRibbonBar {
    background: transparent;
    border-bottom: 1px solid @line;
}
QStackedWidget#studioRibbonPages {
    background-color: @ribbon_page;
}
/* Tabs keep one size in every state (margin + border + padding alike,
 * one text weight), so nothing shifts on hover or click. A tab draws
 * nothing but its name (no border: cheap to paint); hovered, it fills a
 * pill inside its margins; the current one is a folder tab on the page's
 * surface that covers the row's line (its name's accent underline is
 * painted by studio_ribbon._Tabs). The current tab's top margin is
 * studio_ribbon.TAB_TOP. */
QTabBar#studioRibbonTabs::tab:top {
    margin: 7px 4px 3px 3px;
    padding: 3px 12px;
    border: none;
    border-radius: 5px;
    background: transparent;
    color: @text_dim;
}
QTabBar#studioRibbonTabs::tab:top:hover:!selected {
    background-color: @ribbon_tab_hover;
    color: @text;
}
QTabBar#studioRibbonTabs::tab:top:selected {
    margin: 4px 1px 0 0;
    padding: 5px 14px 6px 14px;
    border: 1px solid @line;
    border-bottom: none;
    border-top-left-radius: @radius;
    border-top-right-radius: @radius;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: @ribbon_page;
    color: @text_bright;
}
QTabBar#studioRibbonTabs[collapsed="true"]::tab:top:selected {
    margin: 7px 4px 3px 3px;
    padding: 3px 12px;
    border: none;
    border-radius: 5px;
    background: transparent;
}
QScrollArea#studioRibbonPage,
QWidget#studioRibbonContent {
    background: transparent;
    border: none;
}
QFrame#studioRibbonGroup {
    background: transparent;
    border: none;
    border-right: 1px solid @divider;
}
QLabel#studioRibbonCaption {
    color: @text_dim;
    background: transparent;
    padding: 0;
    margin: 0;
}
QToolButton[studioRibbon="large"] {
    padding: 4px 6px 3px 6px;
}
QToolButton[studioRibbon="small"] {
    padding: 2px 6px 2px 3px;
}
QToolButton[studioRibbon="icon"] {
    padding: 2px;
}
QToolButton[studioRibbon="large"][popupMode="1"] {
    padding-right: 16px;
}
QToolButton[studioRibbon="small"][popupMode="1"],
QToolButton[studioRibbon="small"][popupMode="2"] {
    padding-right: 16px;
}
QToolButton#studioRibbonCollapse {
    qproperty-icon: url();
    image: url(@theme_path/icons/studio/chevron-up.svg);
    padding: 4px;
}
QToolButton#studioRibbonCollapse:checked {
    background: transparent;
}
QToolButton#studioRibbonCollapse:hover {
    background-color: @tool_hover;
}
QToolButton#studioRibbonCollapse[collapsed="true"] {
    image: url(@theme_path/icons/studio/chevron-down.svg);
}
QToolBar[studioLabel="handle"] > QToolButton#qt_toolbar_ext_button {
    image: url(@theme_path/icons/studio/toolbar-more-down.svg);
}

/* =========================================================================
 * 3. BUTTONS
 * ========================================================================= */

QToolButton {
    background: transparent;
    border: none;
    border-radius: @radius;
    padding: 3px;
}
QToolButton:hover {
    background-color: @tool_hover;
}
QToolButton:pressed {
    background-color: @tool_pressed;
}
QToolButton:checked {
    background-color: @tool_checked;
    color: @text_bright;
}
QToolButton:checked:hover {
    background-color: @tool_checked_hover;
}
QToolButton:disabled {
    color: @text_disabled;
}
QToolButton[popupMode="1"] {
    padding-right: 16px;
}
QToolButton[popupMode="2"] {
    padding-right: 12px;
}
QToolButton::menu-button {
    border: none;
    border-top-right-radius: @radius;
    border-bottom-right-radius: @radius;
    width: 14px;
}
QToolButton::menu-button:hover {
    background-color: @tool_hover;
}
/* Drop-down chevrons beside the icon, vertically centred, inside the
 * button's hover and checked fill (not hanging below the icon). */
QToolButton::menu-indicator,
QToolButton::menu-arrow {
    image: url(@theme_path/icons/studio/chevron-down-small.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
}
QToolButton::menu-indicator:disabled,
QToolButton::menu-arrow:disabled {
    image: url(@theme_path/icons/studio/chevron-down-small-disabled.svg);
}

/* Push buttons, fields and combo boxes share one height (the padding is
 * filled in by the plugin: 28 px, compact sizes 26 px), so a row of them
 * lines up. */
/* Secondary buttons are tonal in themes that set @button_border to the
 * fill (a fill and no visible edge), so the default button is the only
 * coloured one in a row; the edge stays in the box so focus can show. */
/* Dialog buttons (Save, Cancel, Close without Saving...) show text only:
 * desktops such as Linux Mint otherwise put their icon theme's old-style
 * icons on them, unlike every other button of the theme. */
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}
QPushButton {
    background-color: @control_bg;
    border: 1px solid @button_border;
    border-radius: @radius;
    padding: @control_padding_y 14px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: @control_hover;
    border-color: @button_border_hover;
}
QPushButton:pressed {
    background-color: @control_pressed;
}
QPushButton:checked {
    background-color: @tool_checked;
    border-color: @accent;
    color: @text_bright;
}
QPushButton:focus {
    border-color: @accent;
}
QPushButton:default {
    background-color: @accent;
    border-color: @accent;
    color: @on_accent;
    font-weight: 600;
}
QPushButton:default:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}
QPushButton:default:pressed {
    background-color: @accent_pressed;
    border-color: @accent_pressed;
}
/* Disabled: the outline only, so it never passes for an enabled button. */
QPushButton:disabled {
    background-color: transparent;
    border-color: @divider_strong;
    color: @text_disabled;
}
/* Inside the button, in its right padding (not on its border). */
QPushButton::menu-indicator {
    image: url(@theme_path/icons/studio/chevron-down-small.svg);
    width: 10px;
    height: 10px;
    subcontrol-position: right center;
    subcontrol-origin: border;
    right: 6px;
}
QgsExpressionBuilderWidget QPushButton {
    min-width: 20px;
    padding: 4px 6px;
}

/* =========================================================================
 * 4. TEXT, NUMBER & CHOICE INPUTS
 * ========================================================================= */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QAbstractSpinBox,
QComboBox {
    background-color: @bg_base;
    border: 1px solid @field_border;
    border-radius: @radius;
    selection-background-color: @accent;
    selection-color: @on_accent;
}
QLineEdit,
QAbstractSpinBox {
    padding: @control_padding_y 8px;
    min-height: 18px;
}
QTextEdit,
QPlainTextEdit {
    padding: 2px;
}
QLineEdit:hover,
QAbstractSpinBox:hover,
QComboBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: @field_border_hover;
}
/* Focus: a 1 px accent edge on a slightly lifted fill. Dialogs focus their
 * search field when they open, so a heavier ring greeted every one of
 * them; this one marks the field without shouting, and the text does not
 * move. */
QLineEdit:focus,
QAbstractSpinBox:focus,
QComboBox:focus,
QComboBox:on,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: @accent;
    background-color: @field_focus;
}
QLineEdit:disabled,
QAbstractSpinBox:disabled,
QComboBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: @bg_window;
    border-color: @divider;
    color: @text_disabled;
}
QLineEdit:read-only {
    background-color: @bg_window;
}

QAbstractSpinBox {
    padding-right: 20px;
}
/* The text field inside spin boxes and editable combo boxes: plain text.
 * The field rules above would give it its own padding, minimum height and
 * border, making it taller than the box, so its text sat low. */
QAbstractSpinBox > QLineEdit,
QAbstractSpinBox > QLineEdit:hover,
QAbstractSpinBox > QLineEdit:focus,
QAbstractSpinBox > QLineEdit:disabled,
QAbstractSpinBox > QLineEdit:read-only,
QComboBox > QLineEdit,
QComboBox > QLineEdit:hover,
QComboBox > QLineEdit:focus,
QComboBox > QLineEdit:disabled,
QComboBox > QLineEdit:read-only {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
    min-height: 0;
}
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
    subcontrol-origin: border;
}
QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    margin: 2px 2px 0 0;
    border-top-right-radius: @radius_sm;
}
QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    margin: 0 2px 2px 0;
    border-bottom-right-radius: @radius_sm;
}
QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: @tool_hover;
}
QAbstractSpinBox::up-button:pressed,
QAbstractSpinBox::down-button:pressed {
    background-color: @tool_checked;
}
/* Outline chevrons, like the combo boxes' and menus' arrows. */
QAbstractSpinBox::up-arrow {
    image: url(@theme_path/icons/studio/arrow-up.svg);
    width: 8px;
    height: 8px;
}
QAbstractSpinBox::down-arrow {
    image: url(@theme_path/icons/studio/arrow-down.svg);
    width: 8px;
    height: 8px;
}
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
    image: url(@theme_path/icons/studio/arrow-up-disabled.svg);
}
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
    image: url(@theme_path/icons/studio/arrow-down-disabled.svg);
}

/* combobox-popup: 0 opens the list below the field (not shifted so the
 * current item covers the field, which clipped short lists such as the
 * labelling mode into a scroll area), drawn with the item rules below. */
QComboBox {
    padding: @control_padding_y 8px;
    min-height: 18px;
    combobox-popup: 0;
}
/* Placed on the border box, which keeps its size with the 2 px focus ring,
 * so the arrow does not move when the field takes focus. */
QComboBox::drop-down {
    border: none;
    width: 22px;
    subcontrol-origin: border;
    subcontrol-position: center right;
}
QComboBox::down-arrow {
    image: url(@theme_path/icons/studio/chevron-down.svg);
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:disabled {
    image: url(@theme_path/icons/studio/chevron-down-disabled.svg);
}
QComboBoxPrivateContainer > QAbstractItemView {
    background-color: @bg_menu;
    color: @text;
    border: 1px solid @menu_edge;
    border-radius: 0;
    padding: 4px;
    outline: none;
    selection-background-color: @menu_hover;
    selection-color: @text_bright;
}
/* Rows as dense as the sub-page lists (Labels, Diagrams): 28 px. */
QComboBoxPrivateContainer > QAbstractItemView::item {
    padding: 3px 8px;
    min-height: 18px;
    border-radius: @radius_sm;
}
QComboBoxPrivateContainer > QAbstractItemView::item:hover,
QComboBoxPrivateContainer > QAbstractItemView::item:selected {
    background-color: @menu_hover;
    color: @text_bright;
}

/* =========================================================================
 * 5. ITEM VIEWS (lists, trees, tables) & HEADERS
 * ========================================================================= */

QAbstractItemView {
    border: 1px solid @divider;
    border-radius: @radius;
    outline: none;
}
QTableView {
    gridline-color: @grid;
}
QTableView > QTableCornerButton::section {
    background-color: @header_bg;
    border: none;
    border-right: 1px solid @divider;
    border-bottom: 1px solid @divider;
}

QHeaderView {
    background-color: @header_bg;
    border: none;
}
QHeaderView::section {
    background-color: @header_bg;
    color: @text_dim;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid @divider;
    border-bottom: 1px solid @divider;
    font-weight: 600;
}
QHeaderView::section:hover {
    background-color: @row_hover;
    color: @text;
}
QHeaderView::section:checked {
    color: @text_bright;
}
/* Attribute tables read as a calmer data grid: no column grid (rows are
 * told apart by their alternating colours), a firm rule under the header
 * and dim row numbers. QGIS paints the cells itself (a QItemDelegate, which
 * ignores ::item rules), so row lines and a row hover are not possible. */
QgsAttributeTableView {
    qproperty-showGrid: false;
}
QgsAttributeTableView > QHeaderView::section:horizontal {
    background-color: @bg_base;
    border-right: 1px solid @grid;
    border-bottom: 1px solid @divider_strong;
}
QgsAttributeTableView > QHeaderView::section:vertical {
    background-color: @bg_base;
    color: @text_disabled;
    font-weight: normal;
    border-right: 1px solid @grid;
    border-bottom: 1px solid @grid;
    padding: 0 8px;
}
QgsAttributeTableView > QTableCornerButton::section {
    background-color: @bg_base;
    border-right: 1px solid @grid;
    border-bottom: 1px solid @divider_strong;
}
/* Table pages of the layer properties (Fields, Actions): a data grid with
 * row lines instead of a cell grid, a header on the table's own surface
 * with one firm rule, and the drop-downs in the cells (Fields >
 * Configuration) without an edge until hovered. The fixed tint QGIS gives
 * marked field rows is blended into the theme by the plugin
 * (_IconDelegate, `soften`). */
QTableWidget#mFieldsList,
QTableWidget#mAttributeActionTable {
    qproperty-showGrid: false;
}
QTableWidget#mFieldsList::item,
QTableWidget#mAttributeActionTable::item {
    border-bottom: 1px solid @grid;
    padding: 0 4px;
}
QTableWidget#mFieldsList::item:selected,
QTableWidget#mAttributeActionTable::item:selected {
    background-color: @row_selected;
    color: @text_bright;
}
QTableWidget#mFieldsList::item:selected:!active,
QTableWidget#mAttributeActionTable::item:selected:!active {
    background-color: @row_selected_inactive;
    color: @text;
}
QTableWidget#mFieldsList > QHeaderView::section:horizontal,
QTableWidget#mAttributeActionTable > QHeaderView::section:horizontal {
    background-color: @bg_base;
    border-right: none;
    border-bottom: 1px solid @line;
}
QTableWidget#mFieldsList > QWidget > QComboBox {
    background-color: transparent;
    border-color: transparent;
}
QTableWidget#mFieldsList > QWidget > QComboBox:hover {
    border-color: @field_border_hover;
}
/* Cell editors fit the row: no field height, padding or focus ring. */
QgsAttributeTableView QLineEdit,
QgsAttributeTableView QComboBox,
QgsAttributeTableView QAbstractSpinBox,
QgsAttributeTableView QLineEdit:focus,
QgsAttributeTableView QComboBox:focus,
QgsAttributeTableView QAbstractSpinBox:focus {
    min-height: 0;
    padding: 0 4px;
    border-width: 1px;
    border-radius: 0;
}
QgsAttributeTableView QAbstractSpinBox,
QgsAttributeTableView QAbstractSpinBox:focus {
    padding-right: 20px;
}
QHeaderView::up-arrow {
    image: url(@theme_path/icons/studio/arrow-up.svg);
    width: 8px;
    height: 8px;
}
QHeaderView::down-arrow {
    image: url(@theme_path/icons/studio/arrow-down.svg);
    width: 8px;
    height: 8px;
}

/* =========================================================================
 * 6. TABS
 * ========================================================================= */

QTabWidget::pane {
    background-color: @bg_window;
    border: 1px solid @divider;
    border-radius: @radius;
    top: -1px;
}
QTabWidget::tab-bar {
    left: 6px;
}
QTabBar {
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background: transparent;
    color: @text_dim;
    border: none;
    padding: 6px 12px;
    margin: 0 2px;
}
QTabBar::tab:top {
    border-bottom: 2px solid transparent;
}
QTabBar::tab:bottom {
    border-top: 2px solid transparent;
}
QTabBar::tab:left {
    border-right: 2px solid transparent;
    padding: 8px 8px;
}
QTabBar::tab:right {
    border-left: 2px solid transparent;
    padding: 8px 8px;
}
QTabBar::tab:hover {
    color: @text;
}
QTabBar::tab:selected {
    color: @text_bright;
}
QTabBar::tab:top:selected {
    border-bottom-color: @accent;
}
QTabBar::tab:bottom:selected {
    border-top-color: @accent;
}
QTabBar::tab:left:selected {
    border-right-color: @accent;
}
QTabBar::tab:right:selected {
    border-left-color: @accent;
}
/* The text format pages (Labels: Text, Formatting, Buffer...) as icon
 * tabs: a soft, short line between them, so they read as tabs rather than
 * a loose row of icons. */
QTabWidget#mOptionsTab > QTabBar::tab:top {
    margin: 0;
}
QTabWidget#mOptionsTab > QTabBar::tab:top:!last {
    background-image: url(@theme_path/icons/studio/tab-separator.svg);
    background-position: right center;
    background-repeat: no-repeat;
}
/* Tabbed panels (Browser, Layers, Processing... sharing one place): a
 * segmented control, the current panel a raised segment on a filled track,
 * instead of loose text tabs. The bar is the main window's own child. */
QMainWindow > QTabBar {
    background-color: @control_bg;
    border-radius: 7px;
    qproperty-expanding: 1;
}
QMainWindow > QTabBar::tab:top,
QMainWindow > QTabBar::tab:bottom {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    margin: 2px 1px;
    padding: 4px 12px;
    color: @text_dim;
}
QMainWindow > QTabBar::tab:top:hover,
QMainWindow > QTabBar::tab:bottom:hover {
    color: @text;
}
QMainWindow > QTabBar::tab:top:selected,
QMainWindow > QTabBar::tab:bottom:selected {
    background-color: @bg_base;
    border-color: @divider;
    color: @text_bright;
}
QTabBar::close-button {
    image: url(@theme_path/icons/studio/close.svg);
    subcontrol-position: right;
    border-radius: @radius_sm;
}
QTabBar::close-button:hover {
    background-color: @tool_hover;
}

/* =========================================================================
 * 7. SCROLLBARS
 * ========================================================================= */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
/* Slim handles: 4 px at rest, 8 px and stronger while the pointer is on the
 * handle or it is dragged. (Not on the whole scrollbar: Qt does not support
 * QScrollBar:hover::handle and paints the whole bar with it instead.) */
QScrollBar::handle {
    background-color: @scroll_handle;
    border-radius: 2px;
}
QScrollBar::handle:vertical {
    min-height: 32px;
    margin: 2px 3px;
}
QScrollBar::handle:horizontal {
    min-width: 32px;
    margin: 3px 2px;
}
QScrollBar::handle:hover,
QScrollBar::handle:pressed {
    background-color: @scroll_handle_hover;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed {
    margin: 2px 1px;
}
QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
    margin: 1px 2px;
}
QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}
QAbstractScrollArea::corner {
    background: transparent;
}

/* =========================================================================
 * 8. CHECKBOXES, RADIO BUTTONS & ITEM INDICATORS
 * ========================================================================= */

QCheckBox,
QRadioButton {
    background: transparent;
    spacing: 8px;
}
/* Room after a radio button's label, so a row of choices (Data Source
 * Manager: File, Directory, Database...) does not run together. */
QRadioButton {
    padding-right: 6px;
}
/* 16 px in all with the border: QGIS lays some rows out at the native
 * indicator height (16 px, e.g. Draw effects), which clipped the top of
 * an 18 px box. */
QCheckBox::indicator,
QGroupBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @field_border_hover;
    background-color: @bg_base;
    border-radius: @radius_sm;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @field_border_hover;
    background-color: @bg_base;
    border-radius: 8px;
}
QCheckBox::indicator:hover,
QRadioButton::indicator:hover,
QGroupBox::indicator:hover {
    border-color: @accent;
}
QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
    image: url(@theme_path/icons/studio/checkbox-check.svg);
}
QRadioButton::indicator:checked {
    background-color: @accent;
    border-color: @accent;
    image: url(@theme_path/icons/studio/radio-dot.svg);
}
QCheckBox::indicator:checked:hover,
QRadioButton::indicator:checked:hover,
QGroupBox::indicator:checked:hover {
    background-color: @accent_hover;
    border-color: @accent_hover;
}
QCheckBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate {
    background-color: @accent_indeterminate;
    border-color: @accent_indeterminate;
    image: url(@theme_path/icons/studio/checkbox-indeterminate.svg);
}
QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled,
QGroupBox::indicator:disabled {
    background-color: @bg_window;
    border-color: @divider_strong;
}
QCheckBox::indicator:checked:disabled,
QRadioButton::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled {
    background-color: @accent_disabled;
    border-color: @accent_disabled;
}

/* =========================================================================
 * 9. GROUPS, SPLITTERS & FRAMES
 * ========================================================================= */

/* Sections, not boxes: the title above a hairline, with no frame around the
 * contents, so dialogs lose their nested boxes. The title sits wholly above
 * the line (none runs through it), so nothing behind it has to be masked
 * on dialogs, panels and tab pages alike. */
QGroupBox,
QgsCollapsibleGroupBox,
QgsCollapsibleGroupBoxBasic {
    background-color: transparent;
    border: none;
    border-top: 1px solid @divider;
    border-radius: 0;
    margin-top: 22px;
    padding: 8px 0 2px 0;
}
/* Titles in the panel titles' voice: the text colour, semibold and a step
 * above the content (sizes filled in by the plugin), in their own case;
 * hierarchy comes from size and weight, not colour or capitals. */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    padding: 0 4px 0 0;
    color: @text;
    font-size: @section_font_size;
    font-weight: 600;
}
QSplitter::handle {
    background-color: transparent;
}
QSplitter::handle:horizontal {
    width: 5px;
}
QSplitter::handle:vertical {
    height: 5px;
}
QSplitter::handle:hover {
    background-color: @accent;
}

/* =========================================================================
 * 10. FEEDBACK (progress, sliders, tooltips, rubber band)
 * ========================================================================= */

QProgressBar {
    background-color: @control_bg;
    color: @text;
    border: none;
    border-radius: @radius_sm;
    text-align: center;
    min-height: 14px;
}
QProgressBar::chunk {
    background-color: @accent;
    border-radius: @radius_sm;
}

/* At least as tall as the knob (16 px with its ring): Qt sizes a slider
 * from the groove, so the knob's top was cut off in opacity sliders. */
QSlider:horizontal {
    min-height: 18px;
}
QSlider:vertical {
    min-width: 18px;
}
QSlider::groove:horizontal {
    background-color: @control_hover;
    height: 4px;
    border-radius: 2px;
}
QSlider::groove:vertical {
    background-color: @control_hover;
    width: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal,
QSlider::add-page:vertical {
    background-color: @accent;
    border-radius: 2px;
}
QSlider::handle:horizontal,
QSlider::handle:vertical {
    background-color: @bg_base;
    border: 3px solid @accent;
    width: 10px;
    height: 10px;
    border-radius: 8px;
}
QSlider::handle:horizontal {
    margin: -6px 0;
}
QSlider::handle:vertical {
    margin: 0 -6px;
}
QSlider::handle:hover {
    border-color: @accent_hover;
}

QToolTip {
    background-color: @bg_menu;
    color: @text;
    border: 1px solid @menu_edge;
    padding: 6px 10px;
}
QRubberBand {
    background-color: @accent_translucent;
    border: 1px solid @accent;
}

/* =========================================================================
 * 11. QGIS WIDGETS
 * ========================================================================= */

/* Panels inside docks read as one surface: no inner frames. */
QgsLayerTreeView,
QgsBrowserTreeView,
QgsProcessingToolboxTreeView,
QgsDockWidget QTreeView,
QgsDockWidget QListView {
    background-color: @bg_dock;
    border: none;
    border-radius: 0;
}

/* Search fields in panels (Processing Toolbox, Browser filter, Layer
 * Styling, Dev Tools filters...): a filled pill with the fields' resting
 * edge, so it reads as a field on the panel (fill alone almost vanished
 * in the light themes), stronger on hover and focus. The selector ends in
 * QgsFilterLineEdit, so Qt checks the ancestor only for those fields. */
QDockWidget QgsFilterLineEdit {
    background-color: @control_bg;
    border-color: @field_border;
    border-radius: @search_radius;
    padding-left: 10px;
    padding-right: 10px;
}
QDockWidget QgsFilterLineEdit:hover {
    border-color: @field_border_hover;
}
QDockWidget QgsFilterLineEdit:focus {
    background-color: @field_focus;
}

QgsColorButton,
QgsColorRampButton {
    background-color: @bg_base;
    border: 1px solid @field_border;
    border-radius: @radius;
    padding: 2px;
    min-height: 18px;
}
QgsColorButton:hover,
QgsColorRampButton:hover {
    border-color: @accent;
}
QgsPropertyOverrideButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @radius_sm;
    padding: 2px;
}
QgsPropertyOverrideButton:hover {
    background-color: @tool_hover;
}
QgsCodeEditor {
    border: 1px solid @divider;
    border-radius: @radius;
}

/* ---- Options / properties navigation lists ------------------------------ */
/* The left column of option dialogs (Options, Layer and Project
 * Properties...): a sidebar set off from the page by a soft line, its
 * search field and page list inset from the window's edge and the line.
 * (Padding on the frame, not a margin on the field: Qt places the field's
 * search and clear icons by its full size.) Only in dialogs: the Dev
 * Tools panel's rail has a frame of that name too, with its own line. */
/* The page side: its buttons (OK, Cancel, Apply, Help) and the page kept
 * clear of the window's right and bottom edges (QGIS leaves 3 px). */
QgsOptionsDialogBase QFrame#mOptionsFrame {
    padding: 0 6px 6px 0;
}
QgsOptionsDialogBase QFrame#mOptionsListFrame {
    border: none;
    border-right: 1px solid @divider;
    padding: 8px 8px 0 8px;
}
QListWidget#mOptionsListWidget,
QListWidget#mOptListWidget,
QListView#mOptionsListWidget,
QTreeView#mOptionsTreeView,
QgsOptionsTreeView {
    background-color: @bg_window;
    border: none;
    border-radius: 0;
    padding: 4px 2px;
}
/* Narrow horizontal padding: when a dialog is too narrow, QGIS collapses
 * this list to an icon-only column, which wider padding pushed the icons
 * out of. */
/* The selected page: a soft pill rounded all round, its icon white like
 * its text (@icon_selected). The sub-page lists of the Labels (Text,
 * Formatting, Buffer...) and Diagrams (Attributes, Rendering, Size...)
 * pages look the same, one size down, instead of a framed box with a grey
 * selection. */
QListWidget#mOptionsListWidget::item,
QListWidget#mOptListWidget::item,
QListView#mOptionsListWidget::item,
QTreeView#mOptionsTreeView::item,
QgsOptionsTreeView::item {
    padding: 5px 6px;
    margin: 1px 4px 1px 0;
    border-radius: @radius;
}
QListWidget#mOptionsListWidget::item:hover,
QListWidget#mOptListWidget::item:hover,
QListView#mOptionsListWidget::item:hover,
QTreeView#mOptionsTreeView::item:hover,
QgsOptionsTreeView::item:hover,
QListWidget#mLabelingOptionsListWidget::item:hover,
QListWidget#mDiagramOptionsListWidget::item:hover {
    background-color: @row_hover_window;
}
QListWidget#mOptionsListWidget::item:selected,
QListWidget#mOptListWidget::item:selected,
QListView#mOptionsListWidget::item:selected,
QTreeView#mOptionsTreeView::item:selected,
QgsOptionsTreeView::item:selected,
QListWidget#mLabelingOptionsListWidget::item:selected,
QListWidget#mDiagramOptionsListWidget::item:selected {
    background-color: @row_selected_window;
    color: @text_bright;
}
/* The Options page tree: like the main panels' trees, a selected or
 * hovered row runs from the tree's edge, its indentation and expand arrow
 * in the same colour, so the row reads as one piece (a pill starting at
 * the item left the indentation as a separate block beside it). */
QTreeView#mOptionsTreeView::item,
QgsOptionsTreeView::item {
    margin: 0 4px 0 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}
/* Hover first: a hovered selected row stays selected all along. */
QTreeView#mOptionsTreeView::branch:hover,
QgsOptionsTreeView::branch:hover {
    background-color: @row_hover_window;
}
QTreeView#mOptionsTreeView::branch:selected,
QgsOptionsTreeView::branch:selected {
    background-color: @row_selected_window;
}
QListWidget#mLabelingOptionsListWidget,
QListWidget#mDiagramOptionsListWidget {
    background-color: transparent;
    border: none;
    border-right: 1px solid @divider;
    border-radius: 0;
    padding: 0;
}
QListWidget#mLabelingOptionsListWidget::item,
QListWidget#mDiagramOptionsListWidget::item {
    padding: 4px;
    margin: 0 4px 1px 0;
    border-radius: @radius;
}

/* ---- Layer Styling / Dev Tools: vertical icon rail ---------------------- */
QgsLayerStylingWidget QListWidget#mOptionsListWidget,
QgsDevToolsPanelWidget QListWidget#mOptionsListWidget {
    background-color: @bg_window;
    border: none;
    border-right: 1px solid @divider;
    padding: 4px;
    min-width: 48px;
    max-width: 48px;
}
QgsLayerStylingWidget QListWidget#mOptionsListWidget::item,
QgsDevToolsPanelWidget QListWidget#mOptionsListWidget::item {
    padding: 6px 0 6px 6px;
    margin: 1px 0;
    min-height: 28px;
    border-radius: @radius;
}

/* ---- Plugin manager list ------------------------------------------------ */
/* QGIS draws the rows itself (checkbox at the row's very edge, no item
 * padding, native checkboxes): room around them on the list instead, so
 * the checkboxes keep clear of its border. */
QListView#vwPlugins {
    padding: 4px 0 4px 8px;
}
QListView#vwPlugins::item {
    padding: 6px 8px;
    border-bottom: 1px solid @divider;
    border-radius: 0;
    min-height: 28px;
}
