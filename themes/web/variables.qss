/* =========================================================================
 * QGIS Premium Dark Theme — Color Variables
 * -------------------------------------------------------------------------
 * Compatible with : QGIS 4.0 / Qt6 theme system (PR #64503)
 * Format          : QGIS variables.qss — `@name: value` per line
 *                   Tokens are text-substituted into style.qss at load time.
 * -------------------------------------------------------------------------
 * Palette DNA — extracted from qgis.org (May 2025)
 *
 *   QGIS Green  #589632   Primary brand / logo outer ring / CTA buttons
 *   Orange      #f07832   Logo arrow glyph / badge stroke (reserved)
 *   Navy black  #060c14   Absolute floor — deepest surface in the UI
 *
 * Design principles
 *   • Every background layer is separated by exactly 6–8 HSL-lightness
 *     points so depth is readable without introducing muddy mid-tones.
 *   • Blue hue is locked at H 215 across the whole background ramp so
 *     all surfaces feel like one material under the same light source.
 *   • Borders are always ~1 stop lighter than their parent surface —
 *     just enough to define edges, never enough to compete with content.
 *   • The green accent stays at QGIS #589632 on the deep navy base,
 *     giving a WCAG AA contrast ratio of ~4.6:1.
 *   • Text uses a cool-white with a faint blue tint (not pure #ffffff)
 *     so it sits naturally on the navy without eye-strain.
 * =========================================================================
 */


/* =========================================================================
 * ACCENT — QGIS Brand Green  #589632
 * =========================================================================
 *  Base    #589632   logo green, interactive elements, focus rings
 *  Hover   +10 L     lighter, energetic feedback
 *  Pressed −10 L     darker, tactile depression
 *  Checked  −8 L + border   distinct from hover
 *  Disabled desaturated, same hue, very low L
 *  Indet.  halfway between disabled and base
 *  Transl. 14 % alpha fill for focus / selection halos
 * =========================================================================
 */
@accent:                 #589632;
@accent_hover:           #64ac38;
@accent_pressed:         #487e28;
@accent_checked_border:  #4c8030;
@accent_disabled:        #2e4a1a;
@accent_indeterminate:   #3d6824;
@accent_translucent:     rgba(88, 150, 50, 0.14);


/* =========================================================================
 * BACKGROUNDS
 * =========================================================================
 *  Ramp (darkest to lightest) — H 215, S 55–60 %, L 4 → 17 %
 *
 *   #060c14  absolute floor  (statusbar, separator fills)
 *   #080f18  base            (tree views, list backgrounds, editors)
 *   #0a1220  alt             (alternating rows, subtle contrast surfaces)
 *   #0c1525  dock            (panel / dock widget chrome)
 *   #0e1929  window          (main window, dialog backgrounds)
 *   #101d2e  menu            (pop-up menus, tooltips)
 *   #121f30  btn hover       (button active state, raised hover)
 *   #172538  hover raised    (elevated cards, combo drop shadows)
 *
 *  Selection surfaces — green-tinted navy, H aligned with accent
 *   #0f2218  selected        (inactive selection)
 *   #133020  selected active (focused selection)
 *   #0d1c2a  selected inact. (unfocused / lost-focus selection)
 *   #122a18  plugin inactive (plugin list unselected)
 *   #1a3820  plugin sel hov  (plugin list hovered selection)
 * =========================================================================
 */
@bg_window:              #0e1929;
@bg_base:                #080f18;
@bg_alt:                 #0a1220;
@bg_dock:                #0c1525;
@bg_statusbar:           #060c14;
@bg_menu:                #101d2e;
@bg_disabled:            #0b1422;
@bg_btn_status_hover:    #0d1826;
@bg_pressed:             #090e1c;
@bg_hover:               #111e30;
@bg_hover_raised:        #172538;
@bg_indicator:           #070d18;
@bg_btn_hover:           #121f30;
@bg_selected:            #0f2218;
@bg_selected_active:     #133020;
@bg_selected_inactive:   #0d1c2a;
@bg_plugin_inactive:     #122a18;
@bg_plugin_sel_hover:    #1a3820;


/* =========================================================================
 * BORDERS / SEPARATORS
 * =========================================================================
 *  Each border token is ~6–8 L points above its matching background so
 *  edges are visible but never dominant.  Blue hue H 215 throughout.
 *
 *  @border              general widget outline
 *  @border_subtle       hairline dividers
 *  @border_darker       deepest inset lines
 *  @border_dim          secondary / muted outlines
 *  @border_btn          button ring at rest
 *  @border_hover        button / field ring on hover
 *  @border_indicator    progress / step indicators
 *  @border_list_item    row separators in lists
 *  @separator_bg        toolbar / menu separator fill
 * =========================================================================
 */
@border:                 #172638;
@border_subtle:          #0d1a28;
@border_darker:          #060b14;
@border_dim:             #112030;
@border_btn:             #1a2c40;
@border_hover:           #234260;
@border_indicator:       #254460;
@border_list_item:       #0e1c2c;
@separator_bg:           #07111e;


/* =========================================================================
 * TEXT
 * =========================================================================
 *  Cool-white family — H 210, S 10–22 %, L stepped 36 → 97 %
 *  Avoids harsh pure-white on deep navy; mirrors the website's body copy.
 *
 *  @text            body / general UI copy
 *  @text_bright     headings, active labels
 *  @text_dim        secondary / metadata
 *  @text_disabled   greyed-out labels
 *  @text_light      slightly muted body
 *  @text_header     panel / dock titles
 *  @text_placeholder input hint text
 *  @text_dark       text on light / accent surfaces
 * =========================================================================
 */
@text:                   #dce6f0;
@text_bright:            #f0f6ff;
@text_dim:               #7a9ab8;
@text_disabled:          #577089;
@text_light:             #c8d8e8;
@text_header:            #b8cede;
@text_placeholder:       #506c88;
@text_dark:              #07111e;




/* =========================================================================
 * SCROLLBAR
 * =========================================================================
 */
@scrollbar_handle_hover: #264060;

/* Structural lines and checked tool buttons, tuned for a dark window: the
 * shared line at about 1.6:1, and a checked tint strong enough to read as
 * the accent rather than a muddy shade of the window. */
@line:                   mix(@bg_window, @text, 0.17);
@tool_checked:           mix(@bg_window, @accent, 0.36);
@tool_checked_hover:     mix(@bg_window, @accent, 0.44);
