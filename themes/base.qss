/* =========================================================================
 * QGIS Studio Themes — shared design tokens
 * -------------------------------------------------------------------------
 * Loaded before each theme's variables.qss; a theme may override any token
 * by defining the same name. Values may reference other tokens and use:
 *   mix(a, b, t)   blend colour a towards b by t (0..1)
 *   alpha(c, a)    colour c with opacity a (0..1)
 * The plugin resolves everything before QGIS loads the stylesheet.
 * =========================================================================
 */

/* ---- Typography --------------------------------------------------------- */
@font_family:            Inter;

/* ---- Geometry ----------------------------------------------------------- */
@radius_sm:              4px;
@radius:                 6px;
@radius_lg:              8px;

/* ---- Status colours (tinted against each theme's surfaces below) -------- */
@info:                   #3b82f6;
@success:                #2fa36b;
@warning:                #e0a030;
@danger:                 #e5484d;

/* ---- Hairlines ---------------------------------------------------------- */
@divider:                mix(@bg_window, @text, 0.09);
@divider_strong:         mix(@bg_window, @text, 0.16);
/* Structural lines: the menu bar's underline, the lines under toolbar rows
 * and the dividers between toolbars share this one colour, about 1.5:1 on
 * the window (dark themes mix less of the text for the same contrast). */
@line:                   mix(@bg_window, @text, 0.22);
@field_border:           mix(@bg_base, @text, 0.20);
@field_border_hover:     mix(@bg_base, @text, 0.34);
/* A focused field: a 1 px accent edge on this barely lifted fill. */
@field_focus:            mix(@bg_base, @text, 0.03);
/* The line between a panel's title and its contents: none where a theme
 * gives both one surface (set it to @bg_dock). */
@dock_seam:              @divider;

/* ---- Controls ----------------------------------------------------------- */
@control_bg:             mix(@bg_window, @text, 0.07);
@control_hover:          mix(@bg_window, @text, 0.12);
@control_pressed:        mix(@bg_window, @text, 0.04);
@tool_hover:             mix(@bg_window, @text, 0.09);
@tool_pressed:           mix(@bg_window, @text, 0.05);
@tool_checked:           mix(@bg_window, @accent, 0.22);
@tool_checked_hover:     mix(@bg_window, @accent, 0.30);
@on_accent:              @text_dark;
/* Secondary push buttons are tonal: a fill and no visible edge. */
@button_border:          transparent;
@button_border_hover:    transparent;
/* Slider knob: solid, so it never reads as a radio button. */
@slider_knob:            #ffffff;
@slider_knob_border:     @field_border_hover;
@slider_knob_hover:      mix(#ffffff, @accent, 0.18);

/* ---- Item views --------------------------------------------------------- */
@row_hover:              mix(@bg_base, @text, 0.05);
/* Hovered rows of the main panels (Layers, Browser, Processing), whose
 * background is the dock's, not the base colour. */
@panel_row_hover:        mix(@bg_dock, @text, 0.07);
@row_selected:           mix(@bg_base, @accent, 0.24);
/* Selected rows keep the accent when their view loses focus, only
 * fainter: a grey selection matched the hover colour exactly. */
@row_selected_inactive:  mix(@bg_base, @accent, 0.11);
@panel_row_selected:     mix(@bg_dock, @accent, 0.24);
@panel_row_selected_inactive: mix(@bg_dock, @accent, 0.12);
/* Page lists on the window surface (dialog page lists, Labels sub-pages). */
@row_hover_window:       mix(@bg_window, @text, 0.05);
@row_selected_window:    mix(@bg_window, @accent, 0.24);
@header_bg:              mix(@bg_base, @text, 0.03);
@grid:                   mix(@bg_base, @text, 0.07);

/* ---- Text roles --------------------------------------------------------- */
/* Labels beside values, and section (group box) titles. */
@text_label:             @text;
@section_title:          @text_dim;

/* ---- Popups ------------------------------------------------------------- */
@menu_border:            mix(@bg_menu, @text, 0.14);
/* Hovered menu and drop-down rows: an accent tint, like selected rows. */
@menu_hover:             mix(@bg_menu, @accent, 0.16);
/* Popups (menus, drop-down lists, tooltips): one even edge around them
 * (dark themes lift them with a lighter surface, see their variables). */
@menu_edge:              mix(@bg_menu, @text, 0.30);

/* ---- Scrollbars --------------------------------------------------------- */
@scroll_handle:          mix(@bg_base, @text, 0.20);
@scroll_handle_hover:    mix(@bg_base, @text, 0.36);

/* ---- Icons (QGIS icon set and widget glyphs) ---------------------------- */
@icon:                   mix(@text, @bg_window, 0.08);
/* Disabled icons and arrows, about 2:1 on the window: clearly unavailable,
 * not a thinner version of the icon (dark themes mix less, same contrast).
 * Disabled text keeps @text_disabled, which stays readable. */
@icon_disabled:          mix(@bg_window, @icon, 0.40);
@icon_accent:            @accent;
/* Icons in selected rows (dialog page lists, Layer Styling, Plugins,
 * Browser, Processing Toolbox): the selected text's colour, like checked
 * tool buttons, on the accent-tinted selection. */
@icon_selected:          @text_bright;

/* ---- Message bar -------------------------------------------------------- */
@info_bg:                mix(@bg_window, @info, 0.14);
@info_border:            mix(@bg_window, @info, 0.45);
@success_bg:             mix(@bg_window, @success, 0.14);
@success_border:         mix(@bg_window, @success, 0.45);
@warning_bg:             mix(@bg_window, @warning, 0.16);
@warning_border:         mix(@bg_window, @warning, 0.50);
@danger_bg:              mix(@bg_window, @danger, 0.14);
@danger_border:          mix(@bg_window, @danger, 0.45);

/* ---- Tables ------------------------------------------------------------- */
@table_alt_bg:           @header_bg;
@table_sel_bg:           @row_selected;
@table_sel_text:         @text_bright;

/* ---- Widget glyph colours (themes/icons templates) ---------------------- */
@arrow_normal:           mix(@text, @bg_window, 0.25);
@arrow_disabled:         @icon_disabled;
@arrow_hover:            @accent;
@branch_hover:           @text_bright;
@checkmark:              @on_accent;
