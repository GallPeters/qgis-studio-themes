/* =========================================================================
 * QGIS Studio Light Orange Theme — Color Variables
 * -------------------------------------------------------------------------
 * Compatible with : QGIS 4.0 / Qt6 theme system (PR #64503)
 * Format          : QGIS variables.qss — `@name: value` per line
 *                   Tokens are text-substituted into style.qss at load time.
 * -------------------------------------------------------------------------
 * Palette DNA — Kartoza brand colours (https://kartoza.com)
 *
 *   Orange  #DF9E2F   highlight1 — primary accent / interaction colour
 *   Blue    #569FC6   highlight2 — hover rings on inputs (darkened to #3E85AC
 *                     so the ring meets WCAG 1.4.11 non-text contrast ≥3:1)
 *   Grey    #8A8B8B   highlight3 — DNA of the warm neutral border ramp
 *   Teal    #06969A   highlight4 — scrollbar hover pop
 *   Red     #CC0403   alert — reserved for future message-bar styling
 *
 * Design principles
 *   • LIGHT theme: backgrounds are a warm paper ramp (near-white → warm
 *     sand), each layer separated by ~3–5 HSL-lightness points.
 *   • Borders sit BELOW their parent surface in lightness (the inverse of
 *     the dark themes) so edges read as gentle shadows, not glow.
 *   • The brand orange #DF9E2F is only 2.3:1 against white, so the working
 *     accent is deepened to #B87812 (3.2:1 on the window bg — passes WCAG 1.4.11
 *     for focus rings and component boundaries). The true brand hue
 *     returns on hover, where it sits on tinted surfaces.
 *   • All accent surfaces carry DARK text/glyphs (@text_dark, @checkmark):
 *     #201A0E on #B87812 is ~4.7:1 — never light-on-light.
 *   • Body text #2E2B24 on the paper ramp is ≥11:1 everywhere.
 * =========================================================================
 */


/* =========================================================================
 * ACCENT — Kartoza Orange  #DF9E2F (deepened to #B87812 at rest)
 * =========================================================================
 *  Base    #B87812   focus rings, checked fills, progress, selections
 *  Hover   #DF9E2F   the true brand hue — brighter, energetic feedback
 *  Pressed −10 L     darker, tactile depression
 *  Checked  border   distinct from hover
 *  Disabled desaturated pale sand
 *  Indet.  halfway between base and hover
 *  Transl. 18 % alpha brand-orange fill for rubber-band / halos
 * =========================================================================
 */
@accent:                 #B87812;
@accent_hover:           #DF9E2F;
@accent_pressed:         #A96E10;
/* Small marks (badge dots): a deeper shade of the brand orange, ~4.3:1. */
@icon_accent:            #95610F;
@accent_checked_border:  #9E640E;
@accent_disabled:        #E8D2A6;
@accent_indeterminate:   #CB8F35;
@accent_translucent:     rgba(223, 158, 47, 0.18);


/* =========================================================================
 * BACKGROUNDS
 * =========================================================================
 *  Warm paper ramp (lightest to darkest)
 *
 *   #FFFDF9  base            (tree views, list backgrounds, editors)
 *   #FBF8F2  menu            (pop-up menus, tooltips)
 *   #F7F2E9  alt             (alternating rows, focused inputs)
 *   #F4EFE6  window          (main window, dialog backgrounds)
 *   #EFE9DD  dock            (panel / dock widget chrome)
 *   #E9E2D2  statusbar       (statusbar, dock titles — darkest chrome)
 *
 *  Selection surfaces — orange-tinted sand, dark text on top
 *   #F5E3BE  selected        (inactive selection)
 *   #F0D69F  selected active (focused selection)
 *   #EFE9DB  selected inact. (unfocused / lost-focus selection)
 * =========================================================================
 */
@bg_window:              #F4EFE6;
@bg_base:                #FFFDF9;
@bg_alt:                 #F7F2E9;
@bg_dock:                #EFE9DD;
@bg_statusbar:           #E9E2D2;
@bg_menu:                #FBF8F2;
@bg_disabled:            #F1ECE2;
@bg_btn_status_hover:    #EDE5D2;
@bg_pressed:             #E4DCC9;
@bg_hover:               #F3EBD9;
@bg_hover_raised:        #F6EDD8;
@bg_indicator:           #FFFFFF;
@bg_btn_hover:           #F1E6CC;
@bg_selected:            #F5E3BE;
@bg_selected_active:     #F0D69F;
@bg_selected_inactive:   #EFE9DB;
@bg_plugin_inactive:     #F2E7CE;
@bg_plugin_sel_hover:    #EDD397;


/* =========================================================================
 * BORDERS / SEPARATORS
 * =========================================================================
 *  Warm greys built from Kartoza grey #8A8B8B, each ~6–10 L points BELOW
 *  its matching background so edges read clearly on the paper surfaces.
 *
 *  @border              general widget outline
 *  @border_subtle       hairline dividers
 *  @border_darker       deepest inset lines
 *  @border_dim          secondary / muted outlines
 *  @border_btn          button ring at rest
 *  @border_hover        input / combo ring on hover — Kartoza blue #569FC6
 *                       darkened to #3E85AC (≥3:1 on all input surfaces)
 *  @border_indicator    checkbox / radio outline (3.7:1 on white)
 *  @border_list_item    row separators + header fill in lists
 *  @separator_bg        toolbar / menu separator fill
 * =========================================================================
 */
@border:                 #C9C2B2;
@border_subtle:          #DDD6C6;
@border_darker:          #B3AB99;
@border_dim:             #D3CCBB;
@border_btn:             #BDB6A5;
@border_hover:           #3E85AC;
@border_indicator:       #857F6E;
@border_list_item:       #E6DFCE;
@separator_bg:           #D8D0BD;


/* =========================================================================
 * TEXT
 * =========================================================================
 *  Warm charcoal family. NOTE the light-theme inversion: @text_bright is
 *  the DARKEST ink (used for emphasis / selected rows) so emphasised text
 *  always gains contrast, never loses it.
 *
 *  @text            body / general UI copy         (≥11:1 on all surfaces)
 *  @text_bright     headings, active labels        (darkest ink)
 *  @text_dim        secondary / metadata           (≥4.5:1 on chrome)
 *  @text_disabled   greyed-out labels
 *  @text_light      slightly muted body (dock titles on @bg_statusbar)
 *  @text_header     panel / dock titles
 *  @text_placeholder input hint text               (≥4.5:1 on @bg_base)
 *  @text_dark       text on accent surfaces        (~4.7:1 on @accent)
 * =========================================================================
 */
@text:                   #2E2B24;
@text_bright:            #1A1812;
@text_dim:               #635D50;
@text_disabled:          #827C70;
@text_light:             #45413A;
@text_header:            #4A4436;
@text_placeholder:       #797163;
@text_dark:              #201A0E;




/* =========================================================================
 * SCROLLBAR
 * =========================================================================
 *  Hover pop uses Kartoza teal #06969A (3.6:1 on the white track).
 * =========================================================================
 */
@scrollbar_handle_hover: #06969A;
