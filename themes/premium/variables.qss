/* =========================================================================
 * QGIS Premium Dark Theme - Color Variables
 * -------------------------------------------------------------------------
 * Compatible with: QGIS 4.0 / Qt6 theme system (PR #64503)
 * Format        : QGIS variables.qss — `@name: value` per line
 *                 Tokens are text-substituted into style.qss at load time.
 * =========================================================================
 */

/* ---- Accent (brand green) ----------------------------------------------- */
@accent:                 #789d4a;
@accent_hover:           #85ae53;
@accent_pressed:         #688840;
@accent_checked_border:  #5a7a3a;
@accent_disabled:        #4a5a3a;
@accent_indeterminate:   #4a6635;
@accent_translucent:     rgba(107, 140, 66, 0.15);

/* ---- Backgrounds -------------------------------------------------------- */
@bg_window:              #2b2b2b;
@bg_base:                #232323;
@bg_alt:                 #262626;
@bg_dock:                #282828;
@bg_statusbar:           #242424;
@bg_menu:                #2d2d2d;
@bg_disabled:            #2e2e2e;
@bg_btn_status_hover:    #2f2f2f;
@bg_pressed:             #2c2c2c;
@bg_hover:               #303030;
@bg_hover_raised:        #383838;
@bg_indicator:           #252525;
@bg_btn_hover:           #404040;
@bg_selected:            #3a4a30;
@bg_selected_active:     #44582f;
@bg_selected_inactive:   #353535;
@bg_plugin_inactive:     #3f4a35;
@bg_plugin_sel_hover:    #4f6638;

/* ---- Borders / separators ----------------------------------------------- */
@border:                 #3a3a3a;
@border_subtle:          #1f1f1f;
@border_darker:          #1c1c1c;
@border_dim:             #333333;
@border_btn:             #3f3f3f;
@border_hover:           #484848;
@border_indicator:       #4a4a4a;
@border_list_item:       #2a2a2a;
@separator_bg:           #222222;

/* ---- Text --------------------------------------------------------------- */
@text:                   #e8e8e8;
@text_bright:            #ffffff;
@text_dim:               #b0b0b0;
@text_disabled:          #7d7d7d;
@text_light:             #d8d8d8;
@text_header:            #d0d0d0;
@text_placeholder:       #787878;
@text_dark:              #1a1a1a;


/* ---- Scrollbar ---------------------------------------------------------- */
@scrollbar_handle_hover: #525252;

/* Structural lines and checked tool buttons, tuned for a dark window: the
 * shared line at about 1.6:1, and a checked tint strong enough to read as
 * the accent rather than a muddy shade of the window. */
@line:                   mix(@bg_window, @text, 0.17);
@tool_checked:           mix(@bg_window, @accent, 0.36);
@tool_checked_hover:     mix(@bg_window, @accent, 0.44);
@icon_disabled:          mix(@bg_window, @icon, 0.26);
